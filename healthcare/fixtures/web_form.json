  "custom_css": "/* Healthcare Clean Theme */\r\n.web-form-container {\r\n    background: white;\r\n    border-radius: 20px;\r\n    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.05);\r\n    padding: 40px;\r\n    margin: 30px auto;\r\n    max-width: 800px;\r\n    border-top: 6px solid #10b981;\r\n    position: relative;\r\n}\r\n\r\n.web-form-container::after {\r\n    content: '🏥';\r\n    position: absolute;\r\n    top: -25px;\r\n    right: 40px;\r\n    font-size: 40px;\r\n    opacity: 0.1;\r\n}\r\n\r\nlabel.control-label {\r\n    font-weight: 600;\r\n    color: #374151;\r\n    font-size: 15px;\r\n    margin-bottom: 10px;\r\n    display: flex;\r\n    align-items: center;\r\n    gap: 8px;\r\n}\r\n\r\nlabel.control-label::before {\r\n    content: '✓';\r\n    color: #10b981;\r\n    font-size: 14px;\r\n    opacity: 0;\r\n    transition: opacity 0.3s ease;\r\n}\r\n\r\n.form-group:focus-within label.control-label::before {\r\n    opacity: 1;\r\n}\r\n\r\n.form-control {\r\n    border: 2px solid #d1d5db;\r\n    border-radius: 10px;\r\n    padding: 14px 18px;\r\n    font-size: 15px;\r\n    background: #f9fafb;\r\n    transition: all 0.3s ease;\r\n}\r\n\r\n.form-control:focus {\r\n    border-color: #10b981;\r\n    background: white;\r\n    box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1);\r\n}\r\n\r\n.form-row {\r\n    display: grid;\r\n    grid-template-columns: repeat(2, 1fr);\r\n    gap: 25px;\r\n    margin-bottom: 25px;\r\n}\r\n\r\n.btn-primary {\r\n    background: #10b981;\r\n    border: none;\r\n    border-radius: 12px;\r\n    padding: 16px 45px;\r\n    font-size: 16px;\r\n    font-weight: 600;\r\n    color: white;\r\n    display: flex;\r\n    align-items: center;\r\n    justify-content: center;\r\n    gap: 10px;\r\n    margin: 40px auto 0;\r\n    transition: all 0.3s ease;\r\n}\r\n\r\n.btn-primary::after {\r\n    content: '→';\r\n    font-size: 20px;\r\n    transition: transform 0.3s ease;\r\n}\r\n\r\n.btn-primary:hover {\r\n    background: #059669;\r\n    transform: translateY(-3px);\r\n    box-shadow: 0 10px 25px rgba(16, 185, 129, 0.3);\r\n}\r\n\r\n.btn-primary:hover::after {\r\n    transform: translateX(5px);\r\n}",
